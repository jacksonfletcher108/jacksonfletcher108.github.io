          "$path": "src/client"
        }
      },
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 50,
        "CameraMaxZoomDistance": 60
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 20.6
      }
    },
    "SoundService": {},
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}
